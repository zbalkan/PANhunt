[Unit]
Description=PANhunt audit profile %i
Documentation=https://github.com/zbalkan/PANhunt
OnFailure=panhunt-alert@%i.service

[Service]
Type=oneshot
User=panhunt
Group=panhunt
UMask=0077
# Exit 130 means operator interruption, not a finding or scanner error.
SuccessExitStatus=130
# %i is the escaped instance name; profiles must use safe ASCII identifiers.
ExecStartPre=+/usr/bin/install -d -o panhunt -g panhunt -m 0700 /var/log/panhunt/%i
WorkingDirectory=/var/log/panhunt/%i
ExecStart=/usr/local/bin/panhunt -C /etc/panhunt/panhunt-%i.ini
CPUQuota=60%
MemoryMax=1G
TasksMax=128
LimitNOFILE=8192
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/var/log/panhunt

[Install]
WantedBy=multi-user.target
